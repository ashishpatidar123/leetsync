{
  "manifest_version": 3,
  "name": "My LeetCode Topic Syncer",
  "version": "1.0",
  "description": "Auto-syncs LeetCode solutions to GitHub and updates the topic-wise README.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}