{
  "manifest_version": 3,
  "name": "LeetSync",
  "version": "1.0",
  "description": "Auto-syncs LeetCode solutions to GitHub and updates the topic-wise README.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icons-16.png",
    "48": "icons/icons-48.png",
    "128": "icons/icons-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icons-16.png",
      "48": "icons/icons-48.png",
      "128": "icons/icons-128.png"
    }
  }
}